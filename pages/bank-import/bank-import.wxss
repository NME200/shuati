/* 配置区 */
.config-section {
  background: var(--bg-card);
  padding: 8rpx 32rpx;
}

.config-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.config-row:last-child {
  border-bottom: none;
}

.config-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.picker-value {
  font-size: 28rpx;
  color: var(--brand-soft-text);
  padding: 8rpx 16rpx;
  background: var(--bg-brand-soft);
  border-radius: 8rpx;
}

/* 格式说明 */
.help-card {
  margin: 20rpx 32rpx;
  padding: 28rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm);
}

.help-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--text-primary);
}

.help-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.help-code {
  background: var(--bg-subtle);
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--text-primary);
  font-family: monospace;
  white-space: pre-wrap;
}

.help-note {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.8;
  margin-top: 16rpx;
}

/* 输入区 */
.input-section {
  margin: 20rpx 32rpx 180rpx;
  padding: 28rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm);
}

.input-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: var(--text-primary);
}

.input-header .input-label {
  margin-bottom: 0;
}

.input-actions {
  display: flex;
  gap: 24rpx;
}

.action-link {
  font-size: 26rpx;
  color: var(--brand-soft-text);
}

.input-area {
  width: 100%;
  height: 400rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: var(--bg-input);
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-primary);
}

.file-picker {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: var(--bg-input);
  border: 2rpx dashed var(--border-base);
  border-radius: 12rpx;
}

.file-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.file-name {
  font-size: 28rpx;
  color: var(--brand-soft-text);
  flex: 1;
}

.url-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: var(--bg-input);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.input-note {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
  margin-top: 20rpx;
}

/* 预览 */
.preview-section {
  margin: 20rpx 32rpx 180rpx;
  padding: 28rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm);
}

.preview-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: var(--brand-soft-text);
}

.preview-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.preview-item:last-child {
  border-bottom: none;
}

.preview-q {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

.preview-answer {
  font-size: 24rpx;
  color: var(--success);
  margin-top: 8rpx;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  box-shadow: var(--shadow-bar);
}

.btn-parse,
.btn-import {
  flex: 1;
  height: 92rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.btn-parse::after,
.btn-import::after {
  border: none;
}

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon {
  font-size: 32rpx;
  line-height: 1;
  margin-right: 12rpx;
}

/* 主操作：实心渐变 + 柔和投影 */
.btn-parse {
  background: var(--gradient-brand-strong);
  color: var(--text-inverse);
  box-shadow: 0 8rpx 20rpx rgba(30, 123, 238, 0.25);
}

/* 次操作：浅蓝底，不与主按钮抢视觉 */
.btn-import {
  background: var(--bg-brand-soft);
  color: var(--brand-soft-text);
  border: 2rpx solid var(--border-base);
}

/* 禁用态：明确置灰，不用透明度淡化导致看不清 */
button.btn-parse[disabled] {
  background: var(--border-strong);
  color: var(--text-inverse);
  box-shadow: none;
  opacity: 1;
}

button.btn-import[disabled] {
  background: var(--bg-subtle);
  color: var(--text-faint);
  border-color: transparent;
  opacity: 1;
}

/* 点击反馈 */
.btn-parse-hover {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-import-hover {
  transform: scale(0.97);
  background: var(--bg-brand-soft);
}

/* 解析中 loading */
.btn-loading {
  width: 28rpx;
  height: 28rpx;
  margin-right: 14rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.45);
  border-top-color: #fff;
  border-radius: 50%;
  animation: btn-spin 0.8s linear infinite;
}

@keyframes btn-spin {
  to {
    transform: rotate(360deg);
  }
}
